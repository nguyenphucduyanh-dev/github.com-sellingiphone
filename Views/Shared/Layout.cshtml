<ul class="navbar-nav ms-auto">
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <!-- Nếu là Admin thì hiện thêm nút vào trang Quản trị -->
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item">
                <a class="nav-link text-warning fw-bold" asp-controller="AdminOrder" asp-action="Index">Quản trị hệ thống</a>
            </li>
        }

        <li class="nav-item">
            <span class="nav-link text-light">Xin chào, @User.Identity.Name!</span>
        </li>
        <li class="nav-item">
            <a class="nav-link text-danger" asp-controller="Account" asp-action="Logout">Đăng xuất</a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" asp-controller="Account" asp-action="Login">Đăng nhập</a>
        </li>
    }
</ul>
