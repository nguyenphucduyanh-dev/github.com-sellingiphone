@model List<PhoneStore.Web.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng của bạn";
}

<div class="container mt-4">
    <h2>Giỏ Hàng Điện Thoại</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info mt-3">
            Giỏ hàng của bạn đang trống. <a asp-controller="Product" asp-action="Index">Quay lại mua sắm</a>
        </div>
    }
    else
    {
        <table class="table table-bordered align-middle mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Hình ảnh</th>
                    <th>Tên sản phẩm</th>
                    <th>Giá bán</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><img src="@item.ImageUrl" style="width: 60px; height: 60px; object-fit: cover;" /></td>
                        <td>@item.ProductName</td>
                        <td>@item.Price.ToString("N0") VNĐ</td>
                        <td>@item.Quantity</td>
                        <td class="fw-bold text-danger">@item.TotalPrice.ToString("N0") VNĐ</td>
                        <td>
                            <a asp-action="Remove" asp-route-id="@item.ProductId" class="btn btn-danger btn-sm">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <h4>Tổng tiền thanh toán: <span class="text-danger">@ViewBag.TotalAmount.ToString("N0") VNĐ</span></h4>
            <div>
                <a asp-controller="Product" asp-action="Index" class="btn btn-secondary">Tiếp tục mua hàng</a>
                <a asp-controller="Order" asp-action="Checkout" class="btn btn-success">Tiến hành đặt hàng</a>
            </div>
        </div>
    }
</div>
