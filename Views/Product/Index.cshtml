@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="container mt-4">
    <h2>Cửa Hàng Điện Thoại</h2>

    <!-- Form Tìm kiếm và Lọc sản phẩm -->
    <form asp-controller="Product" asp-action="Index" method="get" class="row g-3 mb-4">
        
        <!-- Ô nhập từ khóa tìm kiếm -->
        <div class="col-md-4">
            <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Nhập tên điện thoại cần tìm..." />
        </div>

        <!-- Dropdown chọn Hãng sản xuất -->
        <div class="col-md-3">
            <select name="categoryId" class="form-select" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name", ViewBag.SelectedCategoryId))">
                <option value="">-- Tất cả các hãng --</option>
            </select>
        </div>

        <!-- Lọc theo giá tối thiểu -->
        <div class="col-md-2">
            <input type="number" name="minPrice" value="@ViewBag.MinPrice" class="form-control" placeholder="Giá từ (VNĐ)" />
        </div>

        <!-- Lọc theo giá tối đa -->
        <div class="col-md-2">
            <input type="number" name="maxPrice" value="@ViewBag.MaxPrice" class="form-control" placeholder="Đến giá (VNĐ)" />
        </div>

        <!-- Nút bấm thực hiện lọc -->
        <div class="col-md-1">
            <button type="submit" class="btn btn-primary w-100">Lọc</button>
        </div>
    </form>

    <!-- Hiển thị danh sách sản phẩm kết quả -->
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-3 mb-3">
                <div class="card h-100">
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="text-danger fw-bold">@item.Price.ToString("N0") VNĐ</p>
                        <p class="card-text text-muted small">Hãng: @item.Category?.Name</p>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
